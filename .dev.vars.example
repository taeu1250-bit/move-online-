# Optional: only for local Worker testing against an authorized development Firebase project.
# Copy to .dev.vars. Never commit .dev.vars or real server secrets.
# npm run dev:demo does NOT need this file.
FIREBASE_PROJECT_ID=your-development-project
FIREBASE_WEB_API_KEY=your-public-firebase-web-api-key
FIREBASE_APP_ID=your-public-firebase-web-app-id
FIREBASE_AUTH_DOMAIN=your-development-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-development-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-public-sender-id
MOOV_ADMIN_UIDS=[]
MOOV_REMINDERS_ENABLED=0
